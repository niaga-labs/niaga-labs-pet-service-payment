# service-payment -- example environment.
#
# Copy to .env and adjust. .env is gitignored and never committed; this file
# carries no real credentials, only the dev-infra defaults, which are
# placeholders by design.
#
# Two ways to run this service -- see infrastructure/README.md:
#   1. Daily loop      shared dev-infra stack + `go run ./cmd/server` (these values)
#   2. Full-stack smoke  infrastructure/docker-compose.yml, where the hosts below
#                        become service names (db, kafka) instead of localhost
#
# Start the stack first:  cd ~/Documents/dev-infra && ./dev.ps1 up kilat

APP_ENV=development

# Port. NOTE: Desa Murni Batik's services occupy 8001-8009 on the shared laptop,
# so this default collides when both products run at once -- see KPD-65. Override
# with SERVICE_PORT=18002 if you hit "Only one usage of each socket address".
SERVICE_PORT=8002

# Postgres from the shared stack. kilat_secret is a dev-only default.
DB_HOST=localhost
DB_PORT=5432
DB_USER=kilat
DB_PASSWORD=kilat_secret
DB_NAME=kilat_payment
DB_SSL_MODE=disable

# JWT. Must be IDENTICAL across the gateway and every service, or tokens issued
# by service-identity are rejected everywhere else. Replace outside development.
JWT_SECRET=dev-secret-change-me
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=168h

# Kafka from the shared stack.
KAFKA_BROKERS=localhost:9092
KAFKA_GROUP_PREFIX=kilat-

# Cash-out rail. The simulated rail completes after this delay.
CASH_OUT_RAIL_DELAY=5s

# Stripe. Leave EMPTY here -- real keys belong only in your gitignored .env.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Platform fee taken from each payment, in percent. The code uses 15 when this is
# unset or <= 0 (internal/config/config.go).
PLATFORM_FEE_PERCENT=15
